__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/
build/
dist/

# Артефакты прогонов и кэш разобранных шаблонов — ADR-0003.
out/
.cache/
tests/fixtures/*.pptx

# Скачанное для работы: сервер модели, генератор картинок, веса — гигабайты
# чужих файлов, их ставит установщик (Z-76), а не git.
runtime/

# Кэши модели и генератора: ответы модели (cache/llm/) и нарисованные картинки
# (cache/images/, по мегабайту на картинку). Пересоздаются на машине и в
# репозиторий не идут: продукт работает только с моделью (решение пользователя
# 26 сентября, Ш8 снят), а через веб в cache/llm/ ложатся и суждения зрения о
# картинках чужого шаблона — его данные не должны попасть в коммит.
cache/

# Служебные файлы Office, редакторов и системы.
~$*
*.tmp
*.log
.idea/
.vscode/
Thumbs.db
.DS_Store

# Шаблоны третьих лиц кладутся сюда и не коммитятся: они чужие.
# Скачиваются заново скриптом tools/fetch_samples.py, источники — в samples/MANIFEST.md.
samples/

# Материалы ТЗ и всё, что из них собрано. Не коммитятся НИКОГДА, пока не закрыт
# OQ-22: п. 7.3.5 Положения объявляет данные ТЗ конфиденциальными, а публикация
# в открытом репозитории — это передача неограниченному кругу лиц.
# Исключение — наш собственный README с описанием структуры. Записано как
# `tz/*`, а не `tz/`: исключённый каталог git не обходит, и отрицание внутри
# него не срабатывает. Проверено на пробном репозитории, а не выведено.
tz/*
!tz/README.md

# Наш собственный демо-контент лежит в examples/ и коммитится:
# он написан нами и нужен, чтобы всё воспроизводилось с нуля.
